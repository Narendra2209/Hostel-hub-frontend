{
  "name": "hostel-hub-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:shared && tsc -b --noCheck && vite build",
    "typecheck": "npm run build:shared && tsc -b --emitDeclarationOnly false --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run build:shared && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:shared": "npm run build --workspace @hostel/shared",
    "check:shared": "node scripts/check-shared-sync.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@hostel/shared": "*",
    "@tanstack/react-query": "^5.62.16",
    "axios": "^1.7.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.62.16",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  },
  "description": "Hostel Manager - React single-page app",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "shared"
  ]
}
