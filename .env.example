# ---------------------------------------------------------------------------
# Hostel Manager web - environment (template)
#
#   cp apps/web/.env.example apps/web/.env
#
# PUBLIC CONFIGURATION ONLY. Vite compiles every VITE_* value into the
# JavaScript bundle, so anyone who opens the site can read it. A connection
# string, the JWT signing key or an AWS credential must never appear here -
# secrets live only on the server.
#
# apps/web/src/config.ts is the authoritative list, and it reads exactly one
# variable. There is no VITE_AUTH_MODE and no Cognito configuration any more:
# the app has its own accounts, and the login screen asks the API
# (GET /api/auth/status) whether this deployment still needs its first owner.
# ---------------------------------------------------------------------------

# Base URL every API request is sent to. A trailing slash is stripped.
# Local default: http://localhost:4000/api
# Deployed: the API Gateway stage URL that CDK prints as ApiBaseUrl,
#           e.g. https://abc123.execute-api.ap-south-1.amazonaws.com/api
VITE_API_BASE_URL=http://localhost:4000/api
